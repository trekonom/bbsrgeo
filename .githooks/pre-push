#!/usr/bin/env bash
# Refuse the push when man/ or NAMESPACE are stale against the roxygen comments
# (dev/document.R regenerates them and fails on a roxygen warning), or when the
# test suite fails, skips, or warns (about a minute, needs network for the
# validation tests). A push that only changes Markdown files and .scratch/
# skips both and runs dev/check-refs.R instead.
# Bypass once with: git push --no-verify
# Enabled by: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1

zero=0000000000000000000000000000000000000000
docs_only=true
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a ref
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    docs_only=false # new branch or unknown remote state: no range to inspect
    break
  fi
  if git diff --name-only "$remote_sha" "$local_sha" |
    grep -qvE '(^\.scratch/|\.md$)'; then
    docs_only=false
    break
  fi
done

if [ "$docs_only" = true ]; then
  echo "pre-push: only Markdown/.scratch files changed; skipping the test suite." >&2
  exec Rscript dev/check-refs.R
fi
Rscript dev/document.R || exit 1
if ! git diff --quiet -- man NAMESPACE; then
  echo "pre-push: man/ or NAMESPACE differ from the roxygen comments; commit the regenerated files:" >&2
  git diff --stat -- man NAMESPACE >&2
  exit 1
fi
exec Rscript dev/test-all.R
