#!/usr/bin/env bash
# Refuse the commit when R code is not formatted with air, or when a steering
# doc names a file or function that does not exist (dev/check-refs.R).
# Enabled by: git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
dev/format.sh --check
Rscript dev/check-refs.R
